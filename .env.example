# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# ── Storage ───────────────────────────────────────────────────────────────
# auto   = use Redis when reachable, otherwise fall back to memory (dev default)
# redis  = require Redis (recommended in production)
# memory = force in-memory storage (dev only; data is lost on restart)
STORE_DRIVER=auto
REDIS_URL=redis://localhost:6379

# ── Ephemeral bins ────────────────────────────────────────────────────────
# A bin (and all of its requests) expires this many seconds after the last
# received webhook. The TTL refreshes on every captured request.
BIN_TTL_SECONDS=3600
MAX_REQUESTS_PER_BIN=200
MAX_BODY_SIZE=1mb

# ── Proxy / deployment ────────────────────────────────────────────────────
# Set to 1 on Render, Railway, Fly.io, or behind any single reverse proxy so
# req.ip uses X-Forwarded-For. Use a hop count instead of true when possible.
TRUST_PROXY=0

# ── SSE tuning ────────────────────────────────────────────────────────────
SSE_HEARTBEAT_MS=20000
MAX_SSE_CLIENTS_PER_BIN=20

# ── Rate limiting ─────────────────────────────────────────────────────────
# Set to 1 to disable API and ingestion rate limits (useful during load tests).
RATE_LIMIT_DISABLED=0
